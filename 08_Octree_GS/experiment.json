{
  "id": "08",
  "name": "Octree-GS",
  "category": "lod_structured_gaussians",
  "source": {"url": "https://github.com/city-super/Octree-GS.git", "repo_dir": "repo"},
  "mask_strategy": "metrics_only",
  "dataset_compat": "standard_colmap",
  "train": {"cwd": "repo", "commands": [["python", "{repo}/train.py", "-s", "{train_data}", "-m", "{train_output}", "--iterations", "{iterations}", "--test_iterations", "{iterations}", "--save_iterations", "{iterations}"]], "artifacts": ["train"]},
  "test": {"cwd": "repo", "commands": [["python", "{repo}/render.py", "-s", "{test_data}", "-m", "{train_output}", "--iteration", "{iterations}", "--skip_test"], ["python", "{root}/common/metrics.py", "--render-root", "{train_output}/train", "--data", "{test_data}", "--masks", "{test_masks}", "--output", "{test_output}/test_metrics.json"]], "artifacts": ["test"]},
  "artifacts": ["train", "test"],
  "notes": "LOD-structured Gaussian baseline. The official repository is configured for large-scale scene layouts and CUDA extensions."
}
