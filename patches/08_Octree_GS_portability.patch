+def _select_gpu():
+    """Prefer the least-used GPU unless the caller already chose visibility."""
+    if "CUDA_VISIBLE_DEVICES" in os.environ:
+        return
+    try:
+        result = subprocess.run(
+            ["nvidia-smi", "--query-gpu=index,memory.used",
+             "--format=csv,noheader,nounits"],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
+            check=True, timeout=5,
+        )
+    except (OSError, subprocess.SubprocessError, UnicodeError):
+        # Leave visibility unset so CUDA can use its default device.
+        return
+
+    devices = []
+    for row in result.stdout.splitlines():
+        try:
+            index, memory_used = (int(value.strip()) for value in row.split(","))
+        except ValueError:
+            continue
+        if index >= 0 and memory_used >= 0:
+            devices.append((index, memory_used))
+    if devices:
+        os.environ["CUDA_VISIBLE_DEVICES"] = str(min(devices, key=lambda gpu: gpu[1])[0])
+
+
+_select_gpu()
