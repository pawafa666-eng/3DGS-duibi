+def _smoke_iteration_window(args):
+    """Optional environment smoke budget; None preserves the official schedule.
+
+    Smoke resumes the *counter* at iteration_to_load, not the hard-coded 6999.
+    Loading vanilla iteration 10 therefore performs updates 11..20 and saves
+    20.pt after ten real optimizer steps. Losses and their thresholds remain
+    unchanged: entropy/SDF/depth-normal regularization is excluded at 11..20.
+    This validates coarse training only, never mesh/refine or reconstruction.
+    """
+    steps = getattr(args, 'smoke_iterations', None)
+    if steps is None:
+        return None
+    if type(steps) is not int or not 1 <= steps <= 10:
+        raise ValueError('smoke_iterations must be an integer in [1, 10] or None')
+    loaded = getattr(args, 'iteration_to_load', None)
+    if type(loaded) is not int or loaded < 0:
+        raise ValueError('Smoke requires a nonnegative integer iteration_to_load')
+    return loaded + 1, loaded + steps
+
+
